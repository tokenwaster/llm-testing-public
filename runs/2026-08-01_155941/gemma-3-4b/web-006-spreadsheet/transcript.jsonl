   <td><input type=\"text\" id=\"cell-H10\" value=\"8\"></td>\n            <td><input type=\"text\" id=\"cell-I10\" value=\"9\"></td>\n            <td><input type=\"text\" id=\"cell-J10\" value=\"10\"></td>\n        </tr>\n\n    </tbody>\n</table>\n\n<button id=\"export\">Export CSV</button>\n<textarea id=\"csv\" rows=\"10\" cols=\"80\"></textarea>\n\n<script>\nwindow.sheet = {\n  set: function(cellId, formula) {\n    const cell = document.getElementById(cellId);\n    if (formula && formula.startsWith(\"=\")) {\n      cell.value = formula;\n    } else {\n      cell.value = cell.value;\n    }\n  },\n  get: function(cellId) {\n    const cell = document.getElementById(cellId);\n    return cell.value;\n  },\n  raw: function(cellId) {\n    return document.getElementById(cellId).textContent;\n  }\n};\n\ndocument.getElementById(\"export\").addEventListener(\"click\", () => {\n  const csvData = [];\n  for (let i = 1; i <= 10; i++) {\n    let row = \"\";\n    for (let j = 1; j <= 10; j++) {\n      row += window.sheet.get(cellIdFromColumnsAndRows(j,i)) + \",\";\n    }\n    csvData.push(row.slice(0,-1));\n  }\n\n  const textarea = document.getElementById(\"csv\");\n  textarea.value = csvData.join(\"\\n\");\n});\n\n\nfunction cellIdFromColumnsAndRows(column, row) {\n  return \"cell-\" + column + row;\n}\n</script>\n</body>\n</html>\n```", "stop_reason": "stop", "tokens_in": 556, "tokens_out": 2784, "reasoning_tokens": 0, "total_ms": 14899.8, "ttft_ms": 2464.3, "cost_usd": null, "served_by": null, "tool_calls": []}
